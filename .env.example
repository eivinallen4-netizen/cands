# Copy to .env.local (local) or set in the host's environment settings (production).

# Canonical site origin, no trailing slash. Used for metadataBase, canonical URLs,
# the sitemap, robots.txt and JSON-LD. REQUIRED for production: `next build` / `next start`
# fail with a clear error when it is missing. In development it falls back to http://localhost:3040.
# On Vercel it falls back to the project's production domain (VERCEL_PROJECT_PRODUCTION_URL),
# so set it there only to force a specific origin (for example www vs non-www).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where estimate requests go. /api/estimate forwards each request here as
# multipart/form-data: fields variant, service, name, phone, contact (text|call),
# year, make, model, damage (repeated), what, insurance (yes|no|not-sure), insurer, source,
# receivedAt, plus up to 10 JPEG photos under "photos" (downscaled in the browser to 1600px).
# Any endpoint that accepts multipart works (Zapier / Make catch hook, a CRM webhook).
# When unset, /api/estimate returns 503 {"ok":false,"reason":"not_configured"} and the
# form shows an inline error with "Text us instead" / "Call us" buttons (nothing is lost).
ESTIMATE_WEBHOOK_URL=
